      <div class="kpi-row">
        <div class="kpi"><div class="kpi-lbl">Monto IVA</div><div class="kpi-val">{{ trib.monto_iva }}</div></div>
        <div class="kpi"><div class="kpi-lbl">Total Factura</div><div class="kpi-val">{{ trib.total_factura }}</div></div>
        <div class="kpi"><div class="kpi-lbl">Retención IVA</div><div class="kpi-val" style="color:#f472b6">{{ trib.ret_iva }}</div></div>
        <div class="kpi"><div class="kpi-lbl">Retención ISLR</div><div class="kpi-val" style="color:#f472b6">{{ trib.ret_islr }}</div></div>
        <div class="kpi"><div class="kpi-lbl">Neto a Pagar/Cobrar</div><div class="kpi-val" style="color:var(--ok)">{{ trib.neto }}</div></div>
      </div>
