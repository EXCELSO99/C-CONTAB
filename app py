            <div class="kpi"><div class="kpi-lbl">Total Debe</div><div class="kpi-val">{{ diario_res.debe }}</div></div>
            <div class="kpi"><div class="kpi-lbl">Total Haber</div><div class="kpi-val">{{ diario_res.haber }}</div></div>
            <div class="kpi"><div class="kpi-lbl">Diferencia</div><div class="kpi-val">{{ diario_res.dif }}</div></div>
            <div class="kpi"><div class="kpi-lbl">Estado</div><div class="kpi-val">{{ estado_cierre }}</div></div>
          </div>

          <label for="cierre_obs">Nota de cierre</label>
          <input id="cierre_obs" name="cierre_obs" type="text" value="{{ cierre_obs }}" placeholder="Ej: Cierre mensual verificado" />

          <button type="submit" class="btn-fucsia">
            {% if estado_cierre == 'CERRADO' %}Reabrir período contable{% else %}Ejecutar cierre del período{% endif %}
          </button>
        </form>
      </div>

      <div class="table-wrap" style="margin-top:14px;">
        <table>
          <thead>
            <tr><th>#</th><th>Cuenta</th><th>Referencia</th><th>Debe</th><th>Haber</th></tr>
          </thead>
          <tbody>
            {% for a in asientos %}
              <tr>
                <td>{{ loop.index }}</td>
                <td>{{ a.cuenta }}</td>
                <td>{{ a.ref }}</td>
                <td>{{ a.debe }}</td>
                <td>{{ a.haber }}</td>
              </tr>
            {% else %}
              <tr><td colspan="5" style="color:var(--muted)">Sin asientos en el libro diario.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>

    <!-- SEGMENTO 3: TRIBUTOS VENEZUELA (IVA / ISLR) -->
    <section id="s3" class="seg-panel {% if active_seg != 's3' %}hidden{% endif %}">
      <h2 style="margin-top:0">Segmento 3 · Tributos (IVA y Retenciones)</h2>
      <p style="color:var(--muted)">Calcula base imponible, IVA (16% general referencial), retención de IVA (75% o 100%) y retención de ISLR.</p>

      <form method="POST" class="card">
        <input type="hidden" name="codigo" value="{{ codigo }}" />
        <input type="hidden" name="active_seg" value="s3" />
        <input type="hidden" name="accion" value="calcular_tributos" />

        <div class="grid-3">
          <div>
            <label for="trib_base">Base imponible / Monto bruto</label>
            <input id="trib_base" name="trib_base" type="number" step="any" value="{{ trib.base }}" required />
          </div>
          <div>
            <label for="trib_iva_pct">Alícuota IVA (%)</label>
            <input id="trib_iva_pct" name="trib_iva_pct" type="number" step="any" value="{{ trib.iva_pct }}" />
          </div>
          <div>
            <label for="trib_ret_iva_pct">Retención IVA (%)</label>
            <select id="trib_ret_iva_pct" name="trib_ret_iva_pct">
              <option value="75" {% if trib.ret_iva_pct == 75 %}selected{% endif %}>75%</option>
              <option value="100" {% if trib.ret_iva_pct == 100 %}selected{% endif %}>100%</option>
              <option value="0" {% if trib.ret_iva_pct == 0 %}selected{% endif %}>0% (No aplica)</option>
            </select>
          </div>
        </div>

        <div class="grid-2">
          <div>
            <label for="trib_islr_pct">Retención ISLR (%)</label>
            <input id="trib_islr_pct" name="trib_islr_pct" type="number" step="any" value="{{ trib.islr_pct }}" />
          </div>
          <div style="display:flex; align-items:flex-end;">
            <button type="submit" class="btn-fucsia">Calcular tributos</button>
          </div>
        </div>
