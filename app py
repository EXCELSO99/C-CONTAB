          <h3 style="margin-top:0; color:#f9a8d4;">Cierre del período</h3>
          <input type="hidden" name="codigo" value="{{ codigo }}" />
          <input type="hidden" name="active_seg" value="s2" />
          <input type="hidden" name="accion" value="ejecutar_cierre" />

