      <p style="color:var(--muted)">Resumen de resultados y posición financiera calculado desde tus entradas, salidas y libro diario.</p>

      <div class="kpi-row">
        <div class="kpi"><div class="kpi-lbl">Ingresos / Entradas</div><div class="kpi-val" style="color:var(--ok)">{{ resumen.entradas }}</div></div>
        <div class="kpi"><div class="kpi-lbl">Egresos / Salidas</div><div class="kpi-val" style="color:#f472b6">{{ resumen.salidas }}</div></div>
        <div class="kpi"><div class="kpi-lbl">Utilidad / Resultado</div><div class="kpi-val">{{ resumen.saldo }}</div></div>
        <div class="kpi"><div class="kpi-lbl">Total Debe (Diario)</div><div class="kpi-val">{{ diario_res.debe }}</div></div>
        <div class="kpi"><div class="kpi-lbl">Total Haber (Diario)</div><div class="kpi-val">{{ diario_res.haber }}</div></div>
      </div>

      <div class="grid-2">
        <div class="card">
          <h3 style="margin-top:0; color:#f9a8d4;">Estado de Resultados (Resumen)</h3>
          <p><strong>Ingresos operativos:</strong> {{ resumen.entradas }}</p>
          <p><strong>Salidas / Costos y Gastos:</strong> {{ resumen.salidas }}</p>
          <p><strong>Resultado neto:</strong> {{ resumen.saldo }}</p>
        </div>
        <div class="card">
          <h3 style="margin-top:0; color:#f9a8d4;">Balance de Comprobación (Diario)</h3>
          <p><strong>Suma Debe:</strong> {{ diario_res.debe }}</p>
          <p><strong>Suma Haber:</strong> {{ diario_res.haber }}</p>
          <p><strong>Cuadre (Debe - Haber):</strong> {{ diario_res.dif }}</p>
