      <p style="color:var(--muted)">Registra entradas (ingresos/cobros) y salidas (egresos/pagos) de caja o banco de forma ordenada.</p>

      <div class="grid-2">
        <form method="POST" class="card">
          <h3 style="margin-top:0; color:#f9a8d4;">Registrar movimiento</h3>
          <input type="hidden" name="codigo" value="{{ codigo }}" />
          <input type="hidden" name="active_seg" value="s1" />
          <input type="hidden" name="accion" value="agregar_mov" />

          <label for="mov_tipo">Tipo de movimiento</label>
          <select id="mov_tipo" name="mov_tipo">
            <option value="ENTRADA">Entrada (Ingreso / Cobro)</option>
            <option value="SALIDA">Salida (Egreso / Pago)</option>
          </select>

          <label for="mov_cuenta">Cuenta contable (VEN)</label>
          <select id="mov_cuenta" name="mov_cuenta">
            <option value="Banco Nacional">Banco Nacional (Activo)</option>
            <option value="Caja Chica">Caja Chica (Activo)</option>
            <option value="Ventas / Ingresos">Ventas / Ingresos (Ingreso)</option>
            <option value="Compras / Costos">Compras / Costos (Costo)</option>
            <option value="Gastos Administrativos">Gastos Administrativos (Gasto)</option>
            <option value="Cuentas por Cobrar">Cuentas por Cobrar (Activo)</option>
            <option value="Cuentas por Pagar">Cuentas por Pagar (Pasivo)</option>
          </select>

