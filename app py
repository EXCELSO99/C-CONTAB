        <form method="POST" class="card">
          <h3 style="margin-top:0; color:#f9a8d4;">Nuevo asiento contable</h3>
          <input type="hidden" name="codigo" value="{{ codigo }}" />
          <input type="hidden" name="active_seg" value="s2" />
          <input type="hidden" name="accion" value="agregar_asiento" />

          <label for="as_cuenta">Cuenta</label>
          <input id="as_cuenta" name="as_cuenta" type="text" placeholder="Ej: 1.1.01 Caja / Banco" required />

          <label for="as_ref">Descripción / Referencia</label>
          <input id="as_ref" name="as_ref" type="text" placeholder="Ej: Registro de venta / Factura" required />

          <div class="grid-2">
            <div>
              <label for="as_debe">Debe</label>
              <input id="as_debe" name="as_debe" type="number" step="any" value="0" />
            </div>
            <div>
              <label for="as_haber">Haber</label>
              <input id="as_haber" name="as_haber" type="number" step="any" value="0" />
            </div>
          </div>

          <button type="submit" class="btn-fucsia">Registrar asiento</button>
        </form>

